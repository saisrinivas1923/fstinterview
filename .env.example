# ========================================================
# Future Sprint Technologies - Environment Configuration
# ========================================================

# 1. Server Port (Render sets this automatically)
PORT=5000

# 2. JWT Secret for secure student and admin sessions
JWT_SECRET=future_sprint_ultra_secure_jwt_secret_token_2026

# 3. Email Delivery via Resend HTTPS API (Recommended for Render)
# Port 443 HTTPS - Unrestricted on Render & Railway
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=Future Sprint Technologies <onboarding@resend.dev>

# 4. Standard SMTP Mail Credentials (Gmail or Custom SMTP Server)
SMTP_USER=futuresprintinterview@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
FROM_EMAIL="Future Sprint Technologies" <futuresprintinterview@gmail.com>

# 5. Institute Director / Administrator Credentials
ADMIN_EMAIL=admin@futuresprintech.com
ADMIN_PASS=Krishnamohan@123
